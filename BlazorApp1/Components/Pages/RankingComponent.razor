@page "/ranking"
@attribute [Authorize]

<PageTitle>Ranking</PageTitle>

<div class="container-fluid">

    @* Encabezado *@
    <div class="mb-4">

        <h1 class="mb-1">
            Ranking
        </h1>

        <p class="text-secondary mb-0">
            Consulta la clasificación general de los participantes.
        </p>

    </div>

    @* Tarjetas de resumen *@
    <div class="row g-4 mb-4">

        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Participantes
                    </p>

                    <h2 class="mb-0">
                        @Participantes.Count
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Mayor puntaje
                    </p>

                    <h2 class="mb-0">
                        @MayorPuntaje
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Tu posición
                    </p>

                    <h2 class="mb-0">
                        #@PosicionUsuarioActual
                    </h2>

                </div>

            </div>

        </div>

    </div>

    @* Filtros *@
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-6">

                    <label for="buscarUsuario"
                           class="form-label">
                        Buscar participante
                    </label>

                    <input id="buscarUsuario"
                           type="text"
                           class="form-control"
                           placeholder="Escribe un nombre"
                           @bind="UsuarioBuscado"
                           @bind:event="oninput" />

                </div>

                <div class="col-12 col-md-3">

                    <label for="tipoRanking"
                           class="form-label">
                        Clasificación
                    </label>

                    <select id="tipoRanking"
                            class="form-select"
                            @bind="TipoRanking">

                        <option value="general">
                            Ranking general
                        </option>

                        <option value="semanal">
                            Ranking semanal
                        </option>

                    </select>

                </div>

                <div class="col-12 col-md-3">

                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            @onclick="LimpiarFiltro">
                        Limpiar filtro
                    </button>

                </div>

            </div>

        </div>

    </div>

    @* Tabla del ranking *@
    @if (ParticipantesFiltrados.Count == 0)
    {
        <div class="alert alert-warning"
             role="alert">
            No se encontraron participantes.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th class="text-center">Posición</th>
                                <th>Participante</th>
                                <th class="text-center">Pronósticos</th>
                                <th class="text-center">Exactos</th>
                                <th class="text-center">Aciertos</th>
                                <th class="text-center">Puntos</th>
                                <th class="text-center">Insignia</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var participante in ParticipantesFiltrados)
                            {
                                <tr class="@ObtenerClaseFila(participante)">

                                    <td class="text-center">

                                        @if (participante.Posicion == 1)
                                        {
                                            <span title="Primer lugar">
                                                🥇
                                            </span>
                                        }
                                        else if (participante.Posicion == 2)
                                        {
                                            <span title="Segundo lugar">
                                                🥈
                                            </span>
                                        }
                                        else if (participante.Posicion == 3)
                                        {
                                            <span title="Tercer lugar">
                                                🥉
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">
                                                @participante.Posicion
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <span class="fw-semibold">
                                            @participante.Nombre
                                        </span>

                                        @if (participante.EsUsuarioActual)
                                        {
                                            <span class="badge text-bg-primary ms-2">
                                                Tú
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">
                                        @participante.Pronosticos
                                    </td>

                                    <td class="text-center">
                                        @participante.MarcadoresExactos
                                    </td>

                                    <td class="text-center">
                                        @participante.ResultadosCorrectos
                                    </td>

                                    <td class="text-center fw-bold">
                                        @ObtenerPuntos(participante)
                                    </td>

                                    <td class="text-center">
                                        @participante.Insignia
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@* Datos temporales para probar la interfaz.
   Posteriormente se cargarán desde los servicios del ranking. *@
@code {
    private string UsuarioBuscado { get; set; } = string.Empty;

    private string TipoRanking { get; set; } = "general";

    private List<ParticipanteRankingVista> Participantes { get; set; } =
    [
        new()
        {
            Posicion = 1,
            Nombre = "Luis",
            Pronosticos = 15,
            MarcadoresExactos = 7,
            ResultadosCorrectos = 5,
            PuntosGenerales = 31,
            PuntosSemanales = 12,
            Insignia = "🏆"
        },
        new()
        {
            Posicion = 2,
            Nombre = "Daniel",
            Pronosticos = 15,
            MarcadoresExactos = 6,
            ResultadosCorrectos = 5,
            PuntosGenerales = 28,
            PuntosSemanales = 10,
            Insignia = "⭐",
            EsUsuarioActual = true
        },
        new()
        {
            Posicion = 3,
            Nombre = "María",
            Pronosticos = 14,
            MarcadoresExactos = 5,
            ResultadosCorrectos = 6,
            PuntosGenerales = 27,
            PuntosSemanales = 9,
            Insignia = "⚽"
        },
        new()
        {
            Posicion = 4,
            Nombre = "Carlos",
            Pronosticos = 13,
            MarcadoresExactos = 4,
            ResultadosCorrectos = 5,
            PuntosGenerales = 22,
            PuntosSemanales = 8,
            Insignia = "🎯"
        },
        new()
        {
            Posicion = 5,
            Nombre = "Andrea",
            Pronosticos = 12,
            MarcadoresExactos = 3,
            ResultadosCorrectos = 6,
            PuntosGenerales = 21,
            PuntosSemanales = 7,
            Insignia = "🔥"
        }
    ];

    private List<ParticipanteRankingVista> ParticipantesFiltrados =>
        Participantes
            .Where(participante =>
                string.IsNullOrWhiteSpace(UsuarioBuscado)
                ||
                participante.Nombre.Contains(
                    UsuarioBuscado,
                    StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(ObtenerPuntos)
            .ToList();

    private int MayorPuntaje =>
        Participantes.Count == 0
            ? 0
            : Participantes.Max(ObtenerPuntos);

    private int PosicionUsuarioActual
    {
        get
        {
            var rankingOrdenado = Participantes
                .OrderByDescending(ObtenerPuntos)
                .ToList();

            var indice = rankingOrdenado.FindIndex(
                participante => participante.EsUsuarioActual);

            return indice < 0
                ? 0
                : indice + 1;
        }
    }

    private int ObtenerPuntos(
        ParticipanteRankingVista participante)
    {
        return TipoRanking == "semanal"
            ? participante.PuntosSemanales
            : participante.PuntosGenerales;
    }

    private static string ObtenerClaseFila(
        ParticipanteRankingVista participante)
    {
        return participante.EsUsuarioActual
            ? "table-primary"
            : string.Empty;
    }

    private void LimpiarFiltro()
    {
        UsuarioBuscado = string.Empty;
        TipoRanking = "general";
    }

    private sealed class ParticipanteRankingVista
    {
        public int Posicion { get; set; }

        public string Nombre { get; set; } = string.Empty;

        public int Pronosticos { get; set; }

        public int MarcadoresExactos { get; set; }

        public int ResultadosCorrectos { get; set; }

        public int PuntosGenerales { get; set; }

        public int PuntosSemanales { get; set; }

        public string Insignia { get; set; } = string.Empty;

        public bool EsUsuarioActual { get; set; }
    }
}
