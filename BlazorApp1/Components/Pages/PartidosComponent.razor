@page "/partidos"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Partidos</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Partidos</h1>
            <p class="text-secondary mb-0">
                Consulta los próximos partidos del Mundial 2026.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="ActualizarPartidos">
            Actualizar
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert alert-info" role="alert">
            @Mensaje
        </div>
    }

    <div class="row g-4">

        @foreach (var partido in PartidosDisponibles)
        {
            <div class="col-12 col-md-6 col-xl-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header d-flex justify-content-between">
                        <span>@partido.Fase</span>
                        <span class="badge text-bg-primary">
                            @partido.Estado
                        </span>
                    </div>

                    <div class="card-body">

                        <p class="text-center text-secondary">
                            @partido.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <div class="row align-items-center text-center">

                            <div class="col">
                                <h5>@partido.EquipoLocal</h5>
                            </div>

                            <div class="col-auto">
                                <span class="fw-bold">VS</span>
                            </div>

                            <div class="col">
                                <h5>@partido.EquipoVisitante</h5>
                            </div>

                        </div>

                    </div>

                    <div class="card-footer bg-white">
                        <NavLink class="btn btn-outline-primary w-100"
                                 href="@($"/partidos/{partido.Id}")">
                            Ver detalle
                        </NavLink>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@*data para probar la interfaz, se debe de reemplazar con .jason*@

@code {
    private string Mensaje { get; set; } = string.Empty;

    private List<PartidoVista> PartidosDisponibles { get; set; } =
    [
        new()
        {
            Id = 1,
            EquipoLocal = "Costa Rica",
            EquipoVisitante = "Brasil",
            Fecha = new DateTime(2026, 6, 15, 18, 0, 0),
            Fase = "Fase de grupos",
            Estado = "Próximo"
        },
        new()
        {
            Id = 2,
            EquipoLocal = "Argentina",
            EquipoVisitante = "España",
            Fecha = new DateTime(2026, 6, 16, 20, 0, 0),
            Fase = "Fase de grupos",
            Estado = "Próximo"
        },
        new()
        {
            Id = 3,
            EquipoLocal = "Francia",
            EquipoVisitante = "Alemania",
            Fecha = new DateTime(2026, 6, 17, 17, 0, 0),
            Fase = "Fase de grupos",
            Estado = "Próximo"
        }
    ];

    private void ActualizarPartidos()
    {
        Mensaje = $"Partidos actualizados a las {DateTime.Now:HH:mm:ss}.";
    }

    private sealed class PartidoVista
    {
        public int Id { get; set; }

        public string EquipoLocal { get; set; } = string.Empty;

        public string EquipoVisitante { get; set; } = string.Empty;

        public DateTime Fecha { get; set; }

        public string Fase { get; set; } = string.Empty;

        public string Estado { get; set; } = string.Empty;
    }
}
