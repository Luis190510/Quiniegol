@page "/cerrar-sesion"
@rendermode InteractiveServer
@attribute [Authorize]
@inject SesionUsuarioService Sesion
@inject NavigationManager Navigation

<PageTitle>Cerrar sesión</PageTitle>

@code {
    protected override void OnInitialized()
    {
        Sesion.CerrarSesion();
        Navigation.NavigateTo("/");
    }
}
