@page "/resultados"
@attribute [Authorize]
@inject DatosMundialService DatosMundial
@inject FechaSimuladaService FechaSimulada

<PageTitle>Resultados</PageTitle>

<div class="container-fluid">

    @* Encabezado *@
    <div class="mb-4">
        <h1 class="mb-1">Resultados</h1>

        <p class="text-secondary mb-0">
            Consulta los resultados de los partidos finalizados.
        </p>
    </div>

    @* Filtros *@
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-5">

                    <label for="filtroEquipo"
                           class="form-label">
                        Buscar equipo
                    </label>

                    <input id="filtroEquipo"
                           type="text"
                           class="form-control"
                           placeholder="Ejemplo: México"
                           @bind="EquipoBuscado"
                           @bind:event="oninput" />

                </div>

                <div class="col-12 col-md-4">

                    <label for="filtroFase"
                           class="form-label">
                        Fase
                    </label>

                    <select id="filtroFase"
                            class="form-select"
                            @bind="FaseSeleccionada">

                        <option value="">Todas las fases</option>
                        <option value="Fase de grupos">Fase de grupos</option>
                        <option value="Ronda de 32">Ronda de 32</option>
                        <option value="Octavos de final">Octavos de final</option>
                        <option value="Cuartos de final">Cuartos de final</option>
                        <option value="Semifinal">Semifinal</option>
                        <option value="Tercer lugar">Tercer lugar</option>
                        <option value="Final">Final</option>

                    </select>

                </div>

                <div class="col-12 col-md-3">

                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            @onclick="LimpiarFiltros">
                        Limpiar filtros
                    </button>

                </div>

            </div>

        </div>

    </div>

    @* Mensaje informativo *@
    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert alert-info"
             role="alert">
            @Mensaje
        </div>
    }

    @* Tabla de resultados *@
    @if (ResultadosFiltrados.Count == 0)
    {
        <div class="alert alert-warning"
             role="alert">
            No se encontraron resultados con los filtros seleccionados.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>Fecha</th>
                                <th>Fase</th>
                                <th class="text-end">Equipo local</th>
                                <th class="text-center">Marcador</th>
                                <th>Equipo visitante</th>
                                <th class="text-center">Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var resultado in ResultadosFiltrados)
                            {
                                <tr>

                                    <td>
                                        @resultado.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge text-bg-secondary">
                                            @resultado.Fase
                                        </span>
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @resultado.EquipoLocal
                                    </td>

                                    <td class="text-center">

                                        <span class="badge text-bg-primary fs-6">
                                            @resultado.GolesLocal
                                            -
                                            @resultado.GolesVisitante
                                        </span>

                                    </td>

                                    <td class="fw-semibold">
                                        @resultado.EquipoVisitante
                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                @onclick="() => VerDetalle(resultado)">
                                            Ver detalle
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@* Datos temporales para probar la interfaz.
   Posteriormente se cargarán desde resultados2026.json. *@
@code {
    private string EquipoBuscado { get; set; } = string.Empty;

    private string FaseSeleccionada { get; set; } = string.Empty;

    private string Mensaje { get; set; } = string.Empty;

    private List<ResultadoVista> Resultados { get; set; } = [];

    protected override void OnInitialized()
    {
        Resultados = DatosMundial
            .ObtenerPartidos(FechaSimulada.FechaActual)
            .Where(partido => partido.Finalizado)
            .Select(partido => new ResultadoVista
            {
                EquipoLocal = partido.EquipoLocal,
                EquipoVisitante = partido.EquipoVisitante,
                GolesLocal = partido.GolesLocal ?? 0,
                GolesVisitante = partido.GolesVisitante ?? 0,
                Fecha = partido.Fecha,
                Fase = partido.Fase
            })
            .ToList();
    }

    private List<ResultadoVista> ResultadosFiltrados
    {
        get
        {
            return Resultados
                .Where(resultado =>
                    CoincideConEquipo(resultado) &&
                    CoincideConFase(resultado))
                .ToList();
        }
    }

    private bool CoincideConEquipo(ResultadoVista resultado)
    {
        if (string.IsNullOrWhiteSpace(EquipoBuscado))
        {
            return true;
        }

        return resultado.EquipoLocal.Contains(
                   EquipoBuscado,
                   StringComparison.OrdinalIgnoreCase)
               ||
               resultado.EquipoVisitante.Contains(
                   EquipoBuscado,
                   StringComparison.OrdinalIgnoreCase);
    }

    private bool CoincideConFase(ResultadoVista resultado)
    {
        if (string.IsNullOrWhiteSpace(FaseSeleccionada))
        {
            return true;
        }

        return resultado.Fase == FaseSeleccionada;
    }

    private void LimpiarFiltros()
    {
        EquipoBuscado = string.Empty;
        FaseSeleccionada = string.Empty;
        Mensaje = "Los filtros fueron eliminados.";
    }

    private void VerDetalle(ResultadoVista resultado)
    {
        Mensaje =
            $"{resultado.EquipoLocal} {resultado.GolesLocal} - " +
            $"{resultado.GolesVisitante} {resultado.EquipoVisitante}.";
    }

    private sealed class ResultadoVista
    {
        public string EquipoLocal { get; set; } = string.Empty;

        public string EquipoVisitante { get; set; } = string.Empty;

        public int GolesLocal { get; set; }

        public int GolesVisitante { get; set; }

        public DateTime Fecha { get; set; }

        public string Fase { get; set; } = string.Empty;
    }
}
