@page "/administracion-usuarios"
@rendermode InteractiveServer

<PageTitle>Administración de usuarios</PageTitle>

<div class="container-fluid">

    @* Encabezado *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>

            <h1 class="mb-1">
                Administración de usuarios
            </h1>

            <p class="text-secondary mb-0">
                Consulta y administra las cuentas registradas.
            </p>

        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="PrepararNuevoUsuario">
            Agregar usuario
        </button>

    </div>

    @* Mensajes *@
    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @ClaseMensaje alert-dismissible fade show"
             role="alert">

            @Mensaje

            <button type="button"
                    class="btn-close"
                    aria-label="Cerrar"
                    @onclick="CerrarMensaje">
            </button>

        </div>
    }

    @* Confirmación para eliminar *@
    @if (UsuarioPendienteEliminar is not null)
    {
        <div class="alert alert-danger"
             role="alert">

            <h5>
                Confirmar eliminación
            </h5>

            <p>
                ¿Deseas eliminar al usuario
                <strong>@UsuarioPendienteEliminar.NombreUsuario</strong>?
            </p>

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-danger"
                        @onclick="ConfirmarEliminacion">
                    Sí, eliminar
                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="CancelarEliminacion">
                    Cancelar
                </button>

            </div>

        </div>
    }

    @* Formulario para nuevo usuario *@
    @if (MostrarFormulario)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Nuevo usuario
                </h5>

                <button type="button"
                        class="btn-close"
                        aria-label="Cerrar"
                        @onclick="CerrarFormulario">
                </button>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12 col-md-4">

                        <label for="nuevoNombre"
                               class="form-label">
                            Nombre
                        </label>

                        <input id="nuevoNombre"
                               type="text"
                               class="form-control"
                               @bind="NuevoUsuario.Nombre" />

                    </div>

                    <div class="col-12 col-md-4">

                        <label for="nuevoNombreUsuario"
                               class="form-label">
                            Nombre de usuario
                        </label>

                        <input id="nuevoNombreUsuario"
                               type="text"
                               class="form-control"
                               @bind="NuevoUsuario.NombreUsuario" />

                    </div>

                    <div class="col-12 col-md-4">

                        <label for="nuevoCorreo"
                               class="form-label">
                            Correo electrónico
                        </label>

                        <input id="nuevoCorreo"
                               type="email"
                               class="form-control"
                               @bind="NuevoUsuario.Correo" />

                    </div>

                    <div class="col-12 col-md-4">

                        <label for="nuevoRol"
                               class="form-label">
                            Rol
                        </label>

                        <select id="nuevoRol"
                                class="form-select"
                                @bind="NuevoUsuario.Rol">

                            <option value="Participante">
                                Participante
                            </option>

                            <option value="Administrador">
                                Administrador
                            </option>

                        </select>

                    </div>

                    <div class="col-12 col-md-4">

                        <label for="nuevoEstado"
                               class="form-label">
                            Estado
                        </label>

                        <select id="nuevoEstado"
                                class="form-select"
                                @bind="NuevoUsuario.Activo">

                            <option value="@true">
                                Activo
                            </option>

                            <option value="@false">
                                Inactivo
                            </option>

                        </select>

                    </div>

                    <div class="col-12 col-md-4 d-flex align-items-end">

                        <button type="button"
                                class="btn btn-success w-100"
                                @onclick="GuardarNuevoUsuario">
                            Guardar usuario
                        </button>

                    </div>

                </div>

            </div>

        </div>
    }

    @* Tarjetas de resumen *@
    <div class="row g-4 mb-4">

        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Usuarios
                    </p>

                    <h2 class="mb-0">
                        @Usuarios.Count
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Activos
                    </p>

                    <h2 class="mb-0">
                        @CantidadActivos
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Inactivos
                    </p>

                    <h2 class="mb-0">
                        @CantidadInactivos
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <p class="text-secondary mb-2">
                        Administradores
                    </p>

                    <h2 class="mb-0">
                        @CantidadAdministradores
                    </h2>

                </div>

            </div>

        </div>

    </div>

    @* Filtros *@
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-5">

                    <label for="buscarUsuarioAdministracion"
                           class="form-label">
                        Buscar usuario
                    </label>

                    <input id="buscarUsuarioAdministracion"
                           type="text"
                           class="form-control"
                           placeholder="Nombre, usuario o correo"
                           @bind="TextoBusqueda"
                           @bind:event="oninput" />

                </div>

                <div class="col-12 col-md-3">

                    <label for="filtroRol"
                           class="form-label">
                        Rol
                    </label>

                    <select id="filtroRol"
                            class="form-select"
                            @bind="RolSeleccionado">

                        <option value="todos">
                            Todos
                        </option>

                        <option value="Administrador">
                            Administradores
                        </option>

                        <option value="Participante">
                            Participantes
                        </option>

                    </select>

                </div>

                <div class="col-12 col-md-2">

                    <label for="filtroEstadoUsuario"
                           class="form-label">
                        Estado
                    </label>

                    <select id="filtroEstadoUsuario"
                            class="form-select"
                            @bind="EstadoSeleccionado">

                        <option value="todos">
                            Todos
                        </option>

                        <option value="activos">
                            Activos
                        </option>

                        <option value="inactivos">
                            Inactivos
                        </option>

                    </select>

                </div>

                <div class="col-12 col-md-2">

                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            @onclick="LimpiarFiltros">
                        Limpiar
                    </button>

                </div>

            </div>

        </div>

    </div>

    @* Tabla de usuarios *@
    @if (UsuariosFiltrados.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron usuarios.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>Usuario</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Estado</th>
                                <th>Registro</th>
                                <th class="text-center">Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var usuario in UsuariosFiltrados)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @usuario.NombreUsuario
                                        </div>

                                        <small class="text-secondary">
                                            @usuario.Nombre
                                        </small>

                                    </td>

                                    <td>
                                        @usuario.Correo
                                    </td>

                                    <td>

                                        <select class="form-select form-select-sm"
                                                aria-label="Rol del usuario"
                                                @bind="usuario.Rol">

                                            <option value="Participante">
                                                Participante
                                            </option>

                                            <option value="Administrador">
                                                Administrador
                                            </option>

                                        </select>

                                    </td>

                                    <td class="text-center">

                                        @if (usuario.Activo)
                                        {
                                            <span class="badge text-bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @usuario.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex flex-wrap justify-content-center gap-2">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-warning"
                                                    @onclick="() => CambiarEstado(usuario)">

                                                @(usuario.Activo
                                                    ? "Desactivar"
                                                    : "Activar")

                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => SolicitarEliminacion(usuario)">
                                                Eliminar
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@* Datos temporales para probar la administración.
   Posteriormente se cargarán desde usuarios.json. *@
@code {
    private string TextoBusqueda { get; set; } = string.Empty;

    private string RolSeleccionado { get; set; } = "todos";

    private string EstadoSeleccionado { get; set; } = "todos";

    private string Mensaje { get; set; } = string.Empty;

    private string ClaseMensaje { get; set; } = "alert-info";

    private bool MostrarFormulario { get; set; }

    private UsuarioAdministracionVista NuevoUsuario { get; set; } =
        CrearUsuarioVacio();

    private UsuarioAdministracionVista? UsuarioPendienteEliminar { get; set; }

    private List<UsuarioAdministracionVista> Usuarios { get; set; } =
    [
        new()
        {
            Nombre = "Luis Rodríguez",
            NombreUsuario = "Luis190510",
            Correo = "luis@quiniegol.com",
            Rol = "Administrador",
            Activo = true,
            FechaRegistro = new DateTime(2026, 1, 5)
        },
        new()
        {
            Nombre = "Daniel Quesada",
            NombreUsuario = "DanQS",
            Correo = "daniel@quiniegol.com",
            Rol = "Administrador",
            Activo = true,
            FechaRegistro = new DateTime(2026, 1, 10)
        },
        new()
        {
            Nombre = "María Fernández",
            NombreUsuario = "MariaF",
            Correo = "maria@quiniegol.com",
            Rol = "Participante",
            Activo = true,
            FechaRegistro = new DateTime(2026, 2, 1)
        },
        new()
        {
            Nombre = "Carlos Gómez",
            NombreUsuario = "CarlosG",
            Correo = "carlos@quiniegol.com",
            Rol = "Participante",
            Activo = false,
            FechaRegistro = new DateTime(2026, 2, 15)
        }
    ];

    private int CantidadActivos =>
        Usuarios.Count(usuario => usuario.Activo);

    private int CantidadInactivos =>
        Usuarios.Count(usuario => !usuario.Activo);

    private int CantidadAdministradores =>
        Usuarios.Count(usuario =>
            usuario.Rol == "Administrador");

    private List<UsuarioAdministracionVista> UsuariosFiltrados =>
        Usuarios
            .Where(CoincideConBusqueda)
            .Where(CoincideConRol)
            .Where(CoincideConEstado)
            .OrderBy(usuario =>
                usuario.NombreUsuario)
            .ToList();

    private bool CoincideConBusqueda(
        UsuarioAdministracionVista usuario)
    {
        if (string.IsNullOrWhiteSpace(TextoBusqueda))
        {
            return true;
        }

        return usuario.Nombre.Contains(
                   TextoBusqueda,
                   StringComparison.OrdinalIgnoreCase)
               ||
               usuario.NombreUsuario.Contains(
                   TextoBusqueda,
                   StringComparison.OrdinalIgnoreCase)
               ||
               usuario.Correo.Contains(
                   TextoBusqueda,
                   StringComparison.OrdinalIgnoreCase);
    }

    private bool CoincideConRol(
        UsuarioAdministracionVista usuario)
    {
        return RolSeleccionado == "todos"
            ||
            usuario.Rol == RolSeleccionado;
    }

    private bool CoincideConEstado(
        UsuarioAdministracionVista usuario)
    {
        return EstadoSeleccionado switch
        {
            "activos" => usuario.Activo,
            "inactivos" => !usuario.Activo,
            _ => true
        };
    }

    private void PrepararNuevoUsuario()
    {
        NuevoUsuario = CrearUsuarioVacio();
        MostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        MostrarFormulario = false;
    }

    private void GuardarNuevoUsuario()
    {
        if (string.IsNullOrWhiteSpace(NuevoUsuario.Nombre) ||
            string.IsNullOrWhiteSpace(NuevoUsuario.NombreUsuario) ||
            string.IsNullOrWhiteSpace(NuevoUsuario.Correo))
        {
            ClaseMensaje = "alert-danger";
            Mensaje = "Debe completar nombre, usuario y correo.";
            return;
        }

        NuevoUsuario.FechaRegistro = DateTime.Today;

        Usuarios.Add(NuevoUsuario);

        NuevoUsuario = CrearUsuarioVacio();
        MostrarFormulario = false;

        ClaseMensaje = "alert-success";
        Mensaje = "El usuario fue agregado correctamente.";
    }

    private void CambiarEstado(
        UsuarioAdministracionVista usuario)
    {
        usuario.Activo = !usuario.Activo;

        ClaseMensaje = "alert-success";

        Mensaje = usuario.Activo
            ? $"El usuario {usuario.NombreUsuario} fue activado."
            : $"El usuario {usuario.NombreUsuario} fue desactivado.";
    }

    private void SolicitarEliminacion(
        UsuarioAdministracionVista usuario)
    {
        UsuarioPendienteEliminar = usuario;
    }

    private void ConfirmarEliminacion()
    {
        if (UsuarioPendienteEliminar is null)
        {
            return;
        }

        var nombreUsuario =
            UsuarioPendienteEliminar.NombreUsuario;

        Usuarios.Remove(UsuarioPendienteEliminar);
        UsuarioPendienteEliminar = null;

        ClaseMensaje = "alert-success";
        Mensaje = $"El usuario {nombreUsuario} fue eliminado.";
    }

    private void CancelarEliminacion()
    {
        UsuarioPendienteEliminar = null;
    }

    private void LimpiarFiltros()
    {
        TextoBusqueda = string.Empty;
        RolSeleccionado = "todos";
        EstadoSeleccionado = "todos";
    }

    private void CerrarMensaje()
    {
        Mensaje = string.Empty;
    }

    private static UsuarioAdministracionVista CrearUsuarioVacio()
    {
        return new UsuarioAdministracionVista
        {
            Rol = "Participante",
            Activo = true
        };
    }

    private sealed class UsuarioAdministracionVista
    {
        public string Nombre { get; set; } = string.Empty;

        public string NombreUsuario { get; set; } = string.Empty;

        public string Correo { get; set; } = string.Empty;

        public string Rol { get; set; } = "Participante";

        public bool Activo { get; set; }

        public DateTime FechaRegistro { get; set; }
    }
}