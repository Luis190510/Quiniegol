@page "/partidos/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Detalle del partido</PageTitle>

<div class="container-fluid">

    @if (Partido is null)
    {
        <div class="alert alert-warning"
             role="alert">

            <h4 class="alert-heading">
                Partido no encontrado
            </h4>

            <p>
                No existe un partido con el identificador @Id.
            </p>

            <NavLink class="btn btn-outline-primary"
                     href="partidos">
                Volver a partidos
            </NavLink>

        </div>
    }
    else
    {
        @* Navegación de regreso *@
        <div class="mb-4">

            <NavLink class="btn btn-outline-secondary"
                     href="partidos">
                ← Volver a partidos
            </NavLink>

        </div>

        @* Encabezado del partido *@
        <div class="card shadow-sm mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <span>
                    @Partido.Fase
                </span>

                <span class="badge @ObtenerClaseEstado()">
                    @Partido.Estado
                </span>

            </div>

            <div class="card-body py-5">

                <p class="text-center text-secondary">
                    @Partido.Fecha.ToString("dddd, dd MMMM yyyy · HH:mm")
                </p>

                <div class="row align-items-center text-center g-4">

                    <div class="col">

                        <div style="font-size: 3rem;">
                            @Partido.IconoLocal
                        </div>

                        <h2 class="mt-2">
                            @Partido.EquipoLocal
                        </h2>

                    </div>

                    <div class="col-auto">

                        @if (Partido.Finalizado)
                        {
                            <div class="display-5 fw-bold">

                                @Partido.GolesLocal
                                -
                                @Partido.GolesVisitante

                            </div>
                        }
                        else
                        {
                            <div class="display-6 fw-bold">
                                VS
                            </div>
                        }

                    </div>

                    <div class="col">

                        <div style="font-size: 3rem;">
                            @Partido.IconoVisitante
                        </div>

                        <h2 class="mt-2">
                            @Partido.EquipoVisitante
                        </h2>

                    </div>

                </div>

            </div>

        </div>

        <div class="row g-4">

            @* Información general *@
            <div class="col-12 col-xl-6">

                <div class="card shadow-sm h-100">

                    <div class="card-header">

                        <h5 class="mb-0">
                            Información general
                        </h5>

                    </div>

                    <div class="card-body">

                        <dl class="row mb-0">

                            <dt class="col-sm-5">
                                Fecha
                            </dt>

                            <dd class="col-sm-7">
                                @Partido.Fecha.ToString("dd/MM/yyyy")
                            </dd>

                            <dt class="col-sm-5">
                                Hora
                            </dt>

                            <dd class="col-sm-7">
                                @Partido.Fecha.ToString("HH:mm")
                            </dd>

                            <dt class="col-sm-5">
                                Estadio
                            </dt>

                            <dd class="col-sm-7">
                                @Partido.Estadio
                            </dd>

                            <dt class="col-sm-5">
                                Ciudad
                            </dt>

                            <dd class="col-sm-7">
                                @Partido.Ciudad
                            </dd>

                            <dt class="col-sm-5">
                                Fase
                            </dt>

                            <dd class="col-sm-7">
                                @Partido.Fase
                            </dd>

                            <dt class="col-sm-5">
                                Grupo
                            </dt>

                            <dd class="col-sm-7">
                                @Partido.Grupo
                            </dd>

                        </dl>

                    </div>

                </div>

            </div>

            @* Estadísticas del partido *@
            <div class="col-12 col-xl-6">

                <div class="card shadow-sm h-100">

                    <div class="card-header">

                        <h5 class="mb-0">
                            Estadísticas
                        </h5>

                    </div>

                    <div class="card-body">

                        @foreach (var estadistica in Partido.Estadisticas)
                        {
                            <div class="mb-4">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="fw-semibold">
                                        @estadistica.ValorLocal
                                    </span>

                                    <span class="text-secondary">
                                        @estadistica.Nombre
                                    </span>

                                    <span class="fw-semibold">
                                        @estadistica.ValorVisitante
                                    </span>

                                </div>

                                <div class="progress"
                                     style="height: 8px;">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @CalcularPorcentajeLocal(estadistica)%">
                                    </div>

                                    <div class="progress-bar bg-secondary"
                                         role="progressbar"
                                         style="width: @CalcularPorcentajeVisitante(estadistica)%">
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

            @* Acciones disponibles *@
            <div class="col-12">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <div class="d-flex flex-wrap justify-content-center gap-3">

                            @if (!Partido.Finalizado)
                            {
                                <NavLink class="btn btn-primary"
                                         href="pronosticos">
                                    Crear pronóstico
                                </NavLink>
                            }

                            <NavLink class="btn btn-outline-primary"
                                     href="timeline">
                                Ver timeline
                            </NavLink>

                            <NavLink class="btn btn-outline-secondary"
                                     href="tabla-grupos">
                                Ver tabla de grupos
                            </NavLink>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@* El identificador se recibe desde la URL.
   Posteriormente el partido se buscará en partidos.json. *@
