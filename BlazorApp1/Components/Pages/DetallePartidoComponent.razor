                }
            ]
        }
    ];

    protected override void OnParametersSet()
    {
        Partido = PartidosTemporales
            .FirstOrDefault(partido =>
                partido.Id == Id);
    }

    private string ObtenerClaseEstado()
    {
        return Partido?.Finalizado == true
            ? "text-bg-secondary"
            : "text-bg-success";
    }

    private static double CalcularPorcentajeLocal(
        EstadisticaPartidoVista estadistica)
    {
        var total =
            estadistica.ValorLocal +
            estadistica.ValorVisitante;

        return total == 0
            ? 50
            : estadistica.ValorLocal * 100.0 / total;
    }

    private static double CalcularPorcentajeVisitante(
        EstadisticaPartidoVista estadistica)
    {
        return 100 -
            CalcularPorcentajeLocal(estadistica);
    }

    private sealed class PartidoDetalleVista
    {
        public int Id { get; set; }

        public string EquipoLocal { get; set; } = string.Empty;

        public string EquipoVisitante { get; set; } = string.Empty;

        public string IconoLocal { get; set; } = string.Empty;

        public string IconoVisitante { get; set; } = string.Empty;

        public DateTime Fecha { get; set; }

        public string Estadio { get; set; } = string.Empty;

        public string Ciudad { get; set; } = string.Empty;

        public string Fase { get; set; } = string.Empty;

        public string Grupo { get; set; } = string.Empty;

        public string Estado { get; set; } = string.Empty;

        public bool Finalizado { get; set; }

        public int GolesLocal { get; set; }

        public int GolesVisitante { get; set; }

        public List<EstadisticaPartidoVista> Estadisticas { get; set; } = [];
    }

    private sealed class EstadisticaPartidoVista
    {
        public string Nombre { get; set; } = string.Empty;

        public int ValorLocal { get; set; }

        public int ValorVisitante { get; set; }
    }
